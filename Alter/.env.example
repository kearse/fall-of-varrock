# ---- Fall of Varrock — full stack secrets (docker compose) ----
# Copy to .env and fill in. `docker compose up -d` reads this file.

# Web session signing secret — REQUIRED. Use a long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Public URLs
SITE_URL=http://localhost:3000
GAME_WORLD_HOST=localhost

# NodeBB forum URL (the "Forum" nav points here). See forum/README.md.
FORUM_URL=http://localhost:4567
# Production only: parent domain so the login cookie is shared with the forum
# subdomain for SSO (e.g. ".fallofvarrock.com"). Leave blank for local.
AUTH_COOKIE_DOMAIN=

# Enable the "Dev: grant instantly" store button for local testing (0 = off).
STORE_DEV_CHECKOUT=0

# ---- Discord ----
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_FEED_STATUS_ID=
DISCORD_FEED_ACHIEVEMENTS_ID=
DISCORD_FEED_DROPS_ID=
DISCORD_FEED_PK_ID=
DISCORD_FEED_BOSS_ID=
DISCORD_FEED_MODLOG_ID=

# ---- Payments (sandbox until you go live) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
