# ---- Fall of Varrock web platform ----
# Copy to .env.local for `next dev`, or set these in docker-compose.

# MongoDB — MUST be the same database the game server saves to.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lumbridge

# Session signing secret (generate a long random string).
AUTH_SECRET=change-me-to-a-long-random-string

# Public site config
NEXT_PUBLIC_SITE_NAME=Fall of Varrock
NEXT_PUBLIC_GAME_WORLD_HOST=play.fallofvarrock.com
# Absolute site URL (for SEO / Open Graph absolute image URLs). Localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Community Discord invite (used by the header + home + forum widgets).
NEXT_PUBLIC_DISCORD_URL=https://discord.gg

# Game client downloads (shown on /play). Each is a direct download URL; leave a
# platform blank and its button renders a "Building..." placeholder instead.
CLIENT_WINDOWS_URL=
CLIENT_MAC_URL=
CLIENT_LINUX_URL=
CLIENT_JAR_URL=

# NodeBB forum (server-read). The Forum nav + /forum redirect point here when set.
# Leave unset locally to use the built-in fallback forum. See forum/README.md.
FORUM_URL=
# Production: shared parent domain for SSO cookie (e.g. ".fallofvarrock.com").
AUTH_COOKIE_DOMAIN=

# Discord — webhook for one-way announcement posting (Phase 3),
# bot token used by the separate discord-worker (Phase 6).
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_NEWS_CHANNEL_ID=
DISCORD_GUILD_ID=

# Payments (Phase 5) — leave blank until you wire the store.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
