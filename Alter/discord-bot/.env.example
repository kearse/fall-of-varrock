# ---- Fall of Varrock — Discord bot ----
# Copy to .env. The bot shares the SAME MongoDB as the game server and website.

# MongoDB — MUST match web/.env.local and the game server.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lumbridge

# Discord application credentials (Discord Developer Portal → your app).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# The single guild this bot serves. Slash commands register here instantly
# (global registration takes up to 1h). Required for /setup.
DISCORD_GUILD_ID=

# ---- Feed channel IDs ----
# Right-click a channel → Copy Channel ID (needs Developer Mode on).
# After running /setup, the bot prints the IDs it created for each feed.
DISCORD_NEWS_CHANNEL_ID=
DISCORD_FEED_STATUS_ID=
DISCORD_FEED_ACHIEVEMENTS_ID=
DISCORD_FEED_DROPS_ID=
DISCORD_FEED_PK_ID=
DISCORD_FEED_BOSS_ID=
DISCORD_FEED_MODLOG_ID=

# ---- Behaviour ----
# How often (ms) to poll Mongo for new in-game events and news.
FEED_POLL_MS=4000
# How often (ms) to reconcile donor/member/staff Discord roles.
ROLE_SYNC_MS=300000
# Public website base URL (used in embeds / store / seed-content links).
SITE_URL=http://localhost:3000

# Live #server-status board probes the game world over TCP (no game code needed).
GAME_HOST=localhost
GAME_PORT=43594
LIVE_BOARD_MS=60000

# Direct client download links for the #download buttons. Leave blank to hide
# a platform's button — the "All downloads" button (SITE_URL/play) always shows.
# The website's CLIENT_WINDOWS_URL / CLIENT_MAC_URL / CLIENT_LINUX_URL /
# CLIENT_JAR_URL names are accepted as fallbacks, so one .env can feed both.
DOWNLOAD_WINDOWS=
DOWNLOAD_MAC=
DOWNLOAD_LINUX=
DOWNLOAD_JAR=
