# TLS-terminating reverse proxy. Certificates are provisioned automatically
# via Let's Encrypt once DNS for {$DOMAIN} and forum.{$DOMAIN} points at this box.

{$DOMAIN} {
	encode gzip

	# Client distribution: bootstrap.json + client jar + jav_config.ws
	# (files live in /opt/kol/client on the host, mounted read-only)
	handle_path /client/* {
		root * /srv/client
		file_server
	}

	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

forum.{$DOMAIN} {
	encode gzip
	reverse_proxy forum:4567
}
