# TLS-terminating reverse proxy. Certificates are provisioned automatically
# via Let's Encrypt once DNS for {$DOMAIN} and forum.{$DOMAIN} points at this box.

{$DOMAIN} {
	encode gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

forum.{$DOMAIN} {
	encode gzip
	reverse_proxy forum:4567
}
